<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CartSmart.Mobile.Converters"
             x:Class="CartSmart.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:CheckedToStrikethroughConverter x:Key="CheckedToStrikethroughConverter" />
            <converters:CategoryToColorConverter x:Key="CategoryToColorConverter" />
            <converters:ConfidenceToColorConverter x:Key="ConfidenceToColorConverter" />
            <converters:UrgencyToColorConverter x:Key="UrgencyToColorConverter" />
            <converters:ConfidenceTierToColorConverter x:Key="ConfidenceTierToColorConverter" />
            <converters:QuantityUnitConverter x:Key="QuantityUnitConverter" />
            <converters:BoolToChevronConverter x:Key="BoolToChevronConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
