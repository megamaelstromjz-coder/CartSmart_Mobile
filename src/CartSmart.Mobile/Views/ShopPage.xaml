<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             xmlns:models="clr-namespace:CartSmart.Mobile.Models"
             x:Class="CartSmart.Mobile.Views.ShopPage"
             x:DataType="vm:ShopViewModel"
             Title="{Binding ListName}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Label Grid.Column="0" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CheckedCount}" FontAttributes="Bold" />
                        <Span Text=" of " />
                        <Span Text="{Binding TotalCount}" FontAttributes="Bold" />
                        <Span Text=" items" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Column="1" Text="{Binding ProgressText}" VerticalOptions="Center" FontAttributes="Bold" />
            <Button Grid.Column="2" Text="↺ Reset" Style="{StaticResource OutlineButton}" Command="{Binding ResetCommand}" />
        </Grid>

        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="16">

                <CollectionView ItemsSource="{Binding PendingGroups}" IsGrouped="True" SelectionMode="None">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="vm:ItemGroup">
                            <HorizontalStackLayout Spacing="8" Margin="0,12,0,4">
                                <Border Style="{StaticResource PillBorder}">
                                    <Border.Stroke>
                                        <SolidColorBrush Color="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                                    </Border.Stroke>
                                    <Label Text="{Binding Category}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                                </Border>
                                <Label Text="{Binding Count, StringFormat='{0} left'}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ListItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShopViewModel}}, Path=ToggleCheckedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                              InputTransparent="True" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ItemNameLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Style="{StaticResource CaptionLabel}" VerticalOptions="Center">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource QuantityUnitConverter}">
                                                <Binding Path="Quantity" />
                                                <Binding Path="Unit" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}"
                         IsVisible="{Binding BasketItems.Count, Converter={StaticResource CountToBoolConverter}}" />

                <Label Text="In your basket" Style="{StaticResource SectionTitleLabel}" FontSize="16"
                       IsVisible="{Binding BasketItems.Count, Converter={StaticResource CountToBoolConverter}}" />

                <CollectionView ItemsSource="{Binding BasketItems}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ListItem">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Opacity="0.6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShopViewModel}}, Path=ToggleCheckedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                              InputTransparent="True" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           Style="{StaticResource ItemNameLabel}"
                                           TextDecorations="Strikethrough"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="✓" TextColor="{StaticResource SuccessColor}"
                                           FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
