<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             xmlns:models="clr-namespace:CartSmart.Mobile.Models"
             x:Class="CartSmart.Mobile.Views.ListDetailPage"
             x:DataType="vm:ListDetailViewModel"
             Title="{Binding ListName}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

        <!-- FE-1.4: autocomplete text field bound to the local reference list -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Entry Placeholder="Add item"
                   Text="{Binding NewItemName}"
                   TextChanged="OnNewItemTextChanged"
                   WidthRequest="220" />
            <Button Text="Add" Command="{Binding AddItemCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding AutocompleteSuggestions}"
                         HeightRequest="120"
                         IsVisible="{Binding AutocompleteSuggestions.Count, Converter={StaticResource CountToBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReferenceProduct">
                    <Grid Padding="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=PickSuggestionCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- FE-1.1: list view with add/edit/delete, swipe-to-check-off -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ListItem">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Check off"
                                           BackgroundColor="SeaGreen"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=ToggleCheckedCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="IndianRed"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=DeleteItemCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=OpenItemDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{Binding Name}"
                                   TextDecorations="{Binding IsChecked, Converter={StaticResource CheckedToStrikethroughConverter}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Quantity}" VerticalOptions="Center" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
