<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             xmlns:models="clr-namespace:CartSmart.Mobile.Models"
             x:Class="CartSmart.Mobile.Views.ListDetailPage"
             x:DataType="vm:ListDetailViewModel"
             Title="{Binding ListName}">

    <!--
      CollectionView does its own virtualized scrolling — nesting it inside a ScrollView (or
      nesting a second CollectionView inside it) is a documented MAUI hang/crash trap. Everything
      above the list is in Header, the checked-items section is in Footer using BindableLayout
      (not a second CollectionView) since it's a short, non-virtualized list.
    -->
    <CollectionView ItemsSource="{Binding PendingGroups}" IsGrouped="True" SelectionMode="None" Margin="20">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="14" Margin="0,0,0,10">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding ListName}" Style="{StaticResource PageTitleLabel}" FontSize="22" />
                        <Label Style="{StaticResource SubtitleLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding RemainingCount}" />
                                    <Span Text=" remaining · " />
                                    <Span Text="{Binding DoneCount}" />
                                    <Span Text=" done" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="↺ Uncheck all" Style="{StaticResource OutlineButton}"
                                Command="{Binding UncheckAllCommand}"
                                IsVisible="{Binding DoneCount, Converter={StaticResource CountToBoolConverter}}" />
                        <Button Text="🛍 Shop" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartShoppingCommand}" />
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Border Style="{StaticResource AddItemBorder}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="+" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" FontAttributes="Bold" />
                            <Entry Placeholder="Add an item"
                                   Text="{Binding NewItemName}"
                                   TextChanged="OnNewItemTextChanged"
                                   Completed="OnNewItemCompleted"
                                   HorizontalOptions="FillAndExpand"
                                   Style="{StaticResource SearchEntry}" />
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AutocompleteSuggestions}"
                                         IsVisible="{Binding AutocompleteSuggestions.Count, Converter={StaticResource CountToBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ReferenceProduct">
                                <Grid Padding="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=PickSuggestionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:ItemGroup">
                <HorizontalStackLayout Spacing="8" Margin="0,8,0,4">
                    <Border Style="{StaticResource PillBorder}">
                        <Border.Stroke>
                            <SolidColorBrush Color="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                        </Border.Stroke>
                        <Label Text="{Binding Category}" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                    </Border>
                    <Label Text="{Binding Count}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ListItem">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Delete"
                                       BackgroundColor="IndianRed"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=DeleteItemCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=ToggleCheckedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                      InputTransparent="True" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource ItemNameLabel}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource CaptionLabel}">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource QuantityUnitConverter}">
                                                <Binding Path="Quantity" />
                                                <Binding Path="Unit" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Border Style="{StaticResource PillBorder}" Padding="8,1">
                                        <Border.Stroke>
                                            <SolidColorBrush Color="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                                        </Border.Stroke>
                                        <Label Text="{Binding Category}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding Category, Converter={StaticResource CategoryToColorConverter}}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="⋯" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" FontSize="18" />
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0"
                                 IsVisible="{Binding DoneCount, Converter={StaticResource CountToBoolConverter}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCheckedSectionCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding DoneCount}" />
                                <Span Text=" checked items" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding IsCheckedSectionExpanded, Converter={StaticResource BoolToChevronConverter}}"
                           TextColor="{StaticResource TextMuted}" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsCheckedSectionExpanded}"
                                     BindableLayout.ItemsSource="{Binding CheckedItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ListItem">
                            <SwipeView Margin="0,0,0,8">
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="IndianRed"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=DeleteItemCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource CardBorder}" Opacity="0.6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListDetailViewModel}}, Path=ToggleCheckedCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                  InputTransparent="True" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}"
                                               Style="{StaticResource ItemNameLabel}"
                                               TextDecorations="Strikethrough"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2" Style="{StaticResource CaptionLabel}" VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding Converter="{StaticResource QuantityUnitConverter}">
                                                    <Binding Path="Quantity" />
                                                    <Binding Path="Unit" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
