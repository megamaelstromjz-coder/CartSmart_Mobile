<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             xmlns:models="clr-namespace:CartSmart.Mobile.Models"
             x:Class="CartSmart.Mobile.Views.ListsPage"
             x:DataType="vm:ListsViewModel"
             Title="My Lists">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Entry Placeholder="New list name"
                   Text="{Binding NewListName}"
                   WidthRequest="220" />
            <Button Text="Add" Command="{Binding CreateListCommand}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Lists}"
                         SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShoppingList">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="IndianRed"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=DeleteListCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=OpenListCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontSize="16" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
