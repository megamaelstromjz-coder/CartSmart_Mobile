<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             xmlns:models="clr-namespace:CartSmart.Mobile.Models"
             x:Class="CartSmart.Mobile.Views.ListsPage"
             x:DataType="vm:ListsViewModel"
             Title="My Lists">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="14">

        <Border Grid.Row="0" Style="{StaticResource AddItemBorder}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="+" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" FontAttributes="Bold" />
                <Entry Placeholder="New list name"
                       Text="{Binding NewListName}"
                       Completed="OnNewListNameCompleted"
                       HorizontalOptions="FillAndExpand"
                       Style="{StaticResource SearchEntry}" />
            </HorizontalStackLayout>
        </Border>

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Lists}"
                         SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShoppingList">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="IndianRed"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=DeleteListCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=OpenListCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🛒" VerticalOptions="Center" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" Style="{StaticResource ItemNameLabel}" />
                                <Label Grid.Column="2" Text="›" VerticalOptions="Center" TextColor="{StaticResource TextMuted}" FontSize="20" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
