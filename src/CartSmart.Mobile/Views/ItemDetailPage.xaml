<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             x:Class="CartSmart.Mobile.Views.ItemDetailPage"
             x:DataType="vm:ItemDetailViewModel"
             Title="Edit Item">

    <VerticalStackLayout Padding="20" Spacing="16">
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Name" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Name}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Quantity" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Quantity}" Keyboard="Numeric" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Unit" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Unit}" Placeholder="e.g. lb, oz, ct" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Category" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Category}" Placeholder="e.g. Produce, Dairy" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Button Text="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
