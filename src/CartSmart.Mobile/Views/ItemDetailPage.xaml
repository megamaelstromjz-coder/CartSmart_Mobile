<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CartSmart.Mobile.ViewModels"
             x:Class="CartSmart.Mobile.Views.ItemDetailPage"
             x:DataType="vm:ItemDetailViewModel"
             Title="Edit Item">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Name" FontAttributes="Bold" />
        <Entry Text="{Binding Name}" />

        <Label Text="Quantity" FontAttributes="Bold" />
        <Entry Text="{Binding Quantity}" Keyboard="Numeric" />

        <Label Text="Unit" FontAttributes="Bold" />
        <Entry Text="{Binding Unit}" Placeholder="e.g. lb, oz, ct" />

        <Label Text="Category" FontAttributes="Bold" />
        <Entry Text="{Binding Category}" Placeholder="e.g. Produce, Dairy" />

        <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,16,0,0" />
    </VerticalStackLayout>
</ContentPage>
